model Periodo {
  id               String        @id @default(uuid()) @db.Uuid
  cajaId           String        @db.Uuid
  caja             Caja          @relation(fields: [cajaId], references: [id])
  abiertoEn        DateTime      @default(now())
  cerradoEn        DateTime?
  saldoSistema     Int?
  saldoContado     Int?
  diferencia       Int?
  cerradoPorId     String?       @db.Uuid
  cerradoPor       Usuario?      @relation("PeriodoCerrador", fields: [cerradoPorId], references: [id])
  estado           EstadoPeriodo @default(ABIERTO)
  movimientos      Movimiento[]
  creadoEn         DateTime      @default(now())
  actualizadoEn    DateTime      @updatedAt

  @@index([cajaId, estado])
}
